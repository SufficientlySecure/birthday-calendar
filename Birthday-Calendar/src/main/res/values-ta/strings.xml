    <string name="onboarding_contacts_text">பிறந்தநாளைப் படிக்க, பயன்பாட்டிற்கு உங்கள் தொடர்புகளுக்கான அணுகல் தேவை.</string>
    <string name="onboarding_calendar_title">காலெண்டர் அணுகல்</string>
    <string name="onboarding_calendar_text">பிறந்தநாள் நிகழ்வுகளை உருவாக்க, பயன்பாட்டிற்கு உங்கள் காலெண்டருக்கான அணுகல் தேவை.</string>
    <string name="onboarding_finish_title">செயல்படுத்து</string>
    <string name="onboarding_finish_text">பிறந்தநாளைக் காண, உங்கள் கேலெண்டர் பயன்பாட்டின் கணக்கு அமைப்புகளில் பிறந்தநாள் அடாப்டரை இயக்க வேண்டும்.</string>
    <string name="onboarding_finish_warning_title">அனுமதிகள் இல்லை</string>
    <string name="onboarding_finish_warning_text">சில அனுமதிகள் வழங்கப்படவில்லை. பிறந்தநாள் அடாப்டரை இயக்க முடியாது. பயன்பாட்டை மறுதொடக்கம் செய்வதன் மூலம் நீங்கள் பின்னர் அனுமதிகளை வழங்கலாம்.</string>
    <string name="onboarding_grant_permission">இசைவு வழங்கவும்</string>
    <string name="onboarding_permission_denied">இசைவு மறுக்கப்பட்டது. ஆப்ச் எதிர்பார்த்தபடி வேலை செய்யாமல் போகலாம்.</string>
    <string name="onboarding_finish_text_google_calendar">கூகுள் கேலெண்டரில் பிறந்தநாளைப் பார்க்க, மெனுவைத் திறந்து அமைப்புகளுக்குச் செல்லவும். \'கணக்குகளை நிர்வகி\' என்பதைத் தட்டி, \'பிறந்தநாள் அடாப்டர்\' இயக்கப்பட்டிருப்பதை உறுதிசெய்யவும்.</string>
    <string name="onboarding_finish_text_samsung_calendar">சாம்சங் கேலெண்டரில் பிறந்தநாளைப் பார்க்க, மெனுவைத் திறந்து, \'கேலெண்டர்களை நிர்வகி\' என்பதைத் தட்டி, \'பிறந்தநாள் அடாப்டர்\' இயக்கப்பட்டுள்ளதை உறுதிசெய்யவும்.</string>
    <string name="onboarding_finish_text_fossify_calendar">Fossify நாள்காட்டி இல் பிறந்தநாளைப் பார்க்க, அமைப்புகளைத் திறந்து, \'CalDAV ஒத்திசைவைச் செயல்படுத்து\' செயலில் இருப்பதை உறுதிசெய்து, \'ஒத்திசைக்கப்பட்ட காலெண்டர்களை நிர்வகி\' என்பதைத் தேர்ந்தெடுத்து, \'பிறந்தநாள் அடாப்டர்\' இயக்கப்பட்டிருப்பதை உறுதிசெய்யவும்.</string>
