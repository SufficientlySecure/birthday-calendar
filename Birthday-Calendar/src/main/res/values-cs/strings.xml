    <string name="onboarding_finish_warning_title">Chybí oprávnění</string>
    <string name="onboarding_finish_warning_text">Některá oprávnění nebyla udělena. Birthday Adapter nelze aktivovat. Oprávnění můžete udělit později restartováním aplikace.</string>
