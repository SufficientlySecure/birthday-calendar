    <string name="onboarding_finish_title">Aktifkan</string>
    <string name="onboarding_finish_text">Anda perlu mengaktifkan Birthday Adapter di pengaturan akun aplikasi kalender Anda untuk melihat ulang tahunnya.</string>
    <string name="onboarding_finish_warning_title">Izin Tidak Ada</string>
    <string name="onboarding_finish_warning_text">Beberapa izin tidak diberikan. Birthday Adapter tidak dapat diaktifkan. Anda dapat memberikan izin nanti dengan memulai ulang aplikasi.</string>
